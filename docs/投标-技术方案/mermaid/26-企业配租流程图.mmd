flowchart TD
    A["企业提交配租需求<br/>（企业信息+需求房源数）"] --> B["管理端企业资质审核"]
    B -->|"不通过"| C["告知原因"]
    B -->|"通过"| D["创建企业配租批次<br/>（房源范围+窗口期）"]
    D --> E["企业经办人选房<br/>（批量选定房源）"]
    E --> F["企业合同签订<br/>（电子签章）"]
    F --> G["企业员工绑定入住<br/>（员工实名+入住办理）"]
    G --> H["账单生成<br/>（企业统一/员工分摊按约定）"]
    H --> I["缴费/开票/续租/退租<br/>按标准链路办理"]
    I --> J["企业配租台账<br/>管理端全程可查"]
