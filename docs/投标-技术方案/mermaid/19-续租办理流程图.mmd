flowchart TD
    A["系统到期前提醒<br/>（合同到期前触达租户）"] --> B["租户查看续租合同列表"]
    B --> C["续租校验"]
    C --> C1{"资格是否符合"}
    C1 -->|"不符合"| D["提示不符合原因<br/>可发起资格申诉"]
    C1 -->|"符合"| C2{"是否存在欠费"}
    C2 -->|"有欠费"| E["提示先结清欠费<br/>跳转账单缴费"]
    E --> C
    C2 -->|"无欠费"| F["生成续租合同"]
    F --> G["租户在线签订续租合同<br/>（支持合同下载）"]
    G --> H["管理端合同审核"]
    H -->|"审核中"| I["租金缴纳提示<br/>展示审核进度"]
    H -->|"审核通过"| J["租户缴纳租金"]
    J --> K["续租完成<br/>新账期账单生成"]
