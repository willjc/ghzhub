flowchart TD
    A["租户发起服务申请<br/>保洁/搬家/物业报修"] --> B["填写订单信息<br/>（时间/地址/需求描述/照片）"]
    B --> C["订单创建成功<br/>租户可查订单记录与详情"]
    C --> D["管理端订单派单<br/>（指派服务人员）"]
    D --> E["服务执行<br/>（上门服务/维修处理）"]
    E --> F["服务完成确认"]
    F --> G["租户评价<br/>（输入评价内容）"]
    G --> H["订单归档<br/>评价纳入服务质量统计"]
    C -->|"取消"| I["订单取消<br/>（服务执行前可取消）"]
