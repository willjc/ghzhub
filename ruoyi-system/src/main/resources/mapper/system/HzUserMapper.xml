<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.HzUserMapper">

    <resultMap type="com.ruoyi.system.domain.HzUser" id="HzUserResult">
        <id     property="userId"           column="user_id"          />
        <result property="phone"            column="phone"            />
        <result property="contactPhone"     column="contact_phone"    />
        <result property="sourceType"       column="source_type"      />
        <result property="wechatOpenid"     column="wechat_openid"    />
        <result property="wechatUnionid"    column="wechat_unionid"   />
        <result property="zhaohaoUserId"    column="zhaohao_user_id"  />
        <result property="nickname"         column="nickname"         />
        <result property="avatar"           column="avatar"           />
        <result property="realName"         column="real_name"        />
        <result property="gender"           column="gender"           />
        <result property="idCard"           column="id_card"          />
        <result property="education"        column="education"        />
        <result property="identityType"     column="identity_type"    />
        <result property="workUnit"         column="work_unit"        />
        <result property="unitContact"      column="unit_contact"     />
        <result property="unitNature"       column="unit_nature"      />
        <result property="spouseName"       column="spouse_name"      />
        <result property="status"           column="status"           />
        <result property="lastLoginTime"    column="last_login_time"  />
        <result property="lastLoginIp"      column="last_login_ip"    />
        <result property="delFlag"          column="del_flag"         />
        <result property="createBy"         column="create_by"        />
        <result property="createTime"       column="create_time"      />
        <result property="updateBy"         column="update_by"        />
        <result property="updateTime"       column="update_time"      />
        <result property="remark"           column="remark"           />
        <result property="esignPsnId"      column="esign_psn_id"    />
        <result property="authStatus"      column="auth_status"     />
    </resultMap>

    <sql id="selectHzUserVo">
        SELECT user_id, phone, contact_phone, source_type, wechat_openid, wechat_unionid, zhaohao_user_id,
               nickname, avatar, real_name, gender, id_card, education, identity_type,
               work_unit, unit_contact, unit_nature, spouse_name, status,
               last_login_time, last_login_ip, del_flag, create_by, create_time, update_by, update_time, remark,
               esign_psn_id, auth_status
        FROM hz_user
    </sql>

    <select id="selectHzUserList" parameterType="com.ruoyi.system.domain.HzUser" resultMap="HzUserResult">
        <include refid="selectHzUserVo"/>
        <where>
            del_flag = '0'
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
            <if test="realName != null and realName != ''">
                AND real_name LIKE CONCAT('%', #{realName}, '%')
            </if>
            <if test="nickname != null and nickname != ''">
                AND nickname LIKE CONCAT('%', #{nickname}, '%')
            </if>
            <if test="sourceType != null and sourceType != ''">
                AND source_type = #{sourceType}
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="education != null and education != ''">
                AND education = #{education}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND DATE_FORMAT(create_time, '%Y-%m-%d') &gt;= DATE_FORMAT(#{params.beginTime}, '%Y-%m-%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND DATE_FORMAT(create_time, '%Y-%m-%d') &lt;= DATE_FORMAT(#{params.endTime}, '%Y-%m-%d')
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <resultMap type="com.ruoyi.system.domain.vo.HzTenantVO" id="HzTenantViewResult">
        <id property="userId" column="user_id" />
        <result property="realName" column="real_name" />
        <result property="idCard" column="id_card" />
        <result property="phone" column="phone" />
        <result property="contactPhone" column="contact_phone" />
        <result property="gender" column="gender" />
        <result property="education" column="education" />
        <result property="identityType" column="identity_type" />
        <result property="workUnit" column="work_unit" />
        <result property="unitNature" column="unit_nature" />
        <result property="marriageStatus" column="marriage_status" />
        <result property="allocated" column="allocated" />
        <result property="applyTime" column="apply_time" />
        <result property="applyType" column="apply_type" />
        <result property="qualificationResult" column="qualification_result" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectTenantView">
        SELECT u.user_id,
               u.real_name,
               u.id_card,
               u.phone,
               u.contact_phone,
               u.gender,
               u.education,
               u.identity_type,
               u.work_unit,
               u.unit_nature,
               u.marriage_status,
               CASE WHEN EXISTS (
                   SELECT 1
                   FROM hz_contract c
                   WHERE c.tenant_id = u.user_id
                     AND c.del_flag = '0'
                     AND c.contract_status IN ('2', '3')
               ) THEN '1' ELSE '0' END AS allocated,
               q.apply_time,
               q.apply_type,
               q.final_result AS qualification_result,
               u.status,
               u.remark
        FROM hz_user u
        LEFT JOIN hz_qualification q ON q.qualification_id = (
            SELECT latest_q.qualification_id
            FROM hz_qualification latest_q
            WHERE latest_q.tenant_id = u.user_id
              AND latest_q.del_flag = '0'
            ORDER BY latest_q.apply_time DESC, latest_q.qualification_id DESC
            LIMIT 1
        )
    </sql>

    <sql id="tenantViewWhere">
        WHERE u.del_flag = '0'
        <if test="tenant.realName != null and tenant.realName != ''">
            AND u.real_name LIKE CONCAT('%', #{tenant.realName}, '%')
        </if>
        <if test="tenant.idCard != null and tenant.idCard != ''">
            AND u.id_card = #{tenant.idCard}
        </if>
        <if test="tenant.phone != null and tenant.phone != ''">
            AND u.phone = #{tenant.phone}
        </if>
        <if test="tenant.education != null and tenant.education != ''">
            AND u.education = #{tenant.education}
        </if>
        <if test="tenant.identityType != null and tenant.identityType != ''">
            AND u.identity_type = #{tenant.identityType}
        </if>
        <if test="tenant.status != null and tenant.status != ''">
            AND u.status = #{tenant.status}
        </if>
        <if test="tenant.allocated != null and tenant.allocated == &quot;1&quot;">
            AND EXISTS (
                SELECT 1
                FROM hz_contract c
                WHERE c.tenant_id = u.user_id
                  AND c.del_flag = '0'
                  AND c.contract_status IN ('2', '3')
            )
        </if>
        <if test="tenant.allocated != null and tenant.allocated == &quot;0&quot;">
            AND NOT EXISTS (
                SELECT 1
                FROM hz_contract c
                WHERE c.tenant_id = u.user_id
                  AND c.del_flag = '0'
                  AND c.contract_status IN ('2', '3')
            )
        </if>
        <if test="tenant.params.beginApplyTime != null and tenant.params.beginApplyTime != ''">
            AND q.apply_time &gt;= CONCAT(#{tenant.params.beginApplyTime}, ' 00:00:00')
        </if>
        <if test="tenant.params.endApplyTime != null and tenant.params.endApplyTime != ''">
            AND q.apply_time &lt;= CONCAT(#{tenant.params.endApplyTime}, ' 23:59:59')
        </if>
    </sql>

    <select id="selectTenantPage" resultMap="HzTenantViewResult">
        <include refid="selectTenantView" />
        <include refid="tenantViewWhere" />
        ORDER BY u.user_id DESC
    </select>

    <select id="selectTenantByUserId" resultMap="HzTenantViewResult">
        <include refid="selectTenantView" />
        WHERE u.user_id = #{userId}
          AND u.del_flag = '0'
    </select>

</mapper>
